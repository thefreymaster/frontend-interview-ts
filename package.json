{
  "name": "typescript-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "server": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "express": "4.21.*",
    "socket.io": "4.8.*",
    "socket.io-client": "4.8.*",
    "swagger-ui-express": "5.0.*"
  },
  "devDependencies": {
    "@eslint/js": "9.21.*",
    "@types/express": "5.0.*",
    "@types/node": "22.13.*",
    "@types/swagger-ui-express": "4.1.*",
    "eslint": "9.21.*",
    "globals": "15.15.*",
    "tsx": "4.23.*",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.24.*"
  }
}
